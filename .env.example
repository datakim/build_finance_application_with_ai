# Copy this file to .env in the repository root (appendix A.4) and fill in the keys you need.
# .env is git-ignored, so your keys stay on your machine.
#
# Listing A.2 in the book also shows WNN_API_KEY and SLACK_BOT_TOKEN. The code doesn't use them:
# World Nuclear News is read as an RSS feed, and chapter 14 posts through a Slack incoming webhook.
# Chapter 12 needs FRED_API_KEY, which listing A.2 doesn't show.

# OpenAI: chapters 2, 3, 11, 12, 13 and 14
OPENAI_API_KEY=your_openai_api_key_here

# NewsAPI (chapter 11). The free Developer plan returns articles from the last month only,
# with a 24-hour delay, and is for development and testing.
NEWS_API_KEY=your_newsapi_key_here

# FRED macroeconomic data (chapter 12). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Slack incoming-webhook URL for the retention alert (chapter 14), in the form
# https://hooks.slack.com/services/... Optional: leave it empty and the post is skipped.
SLACK_WEBHOOK_URL=
